<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>For Ahmed ♥</title>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Anton&display=swap" rel="stylesheet">
<style>
  :root {
    --bg1: #2a0f1f;
    --bg2: #5c1a33;
    --paper: #fff8f0;
    --ink: #4a1c2b;
    --accent: #d6336c;
    --env: #f1c4cc;
    --env-dark: #d98c9b;
    --blue: #034694;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 50% 30%, var(--bg2), var(--bg1));
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--ink);
    overflow: hidden;
    padding: 16px;
  }

  /* Floating hearts */
  #hearts { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
  .heart { position: absolute; bottom: -40px; opacity: .75; animation: rise linear forwards; }
  @keyframes rise { to { transform: translateY(-110vh) rotate(var(--r)); opacity: 0; } }

  /* Envelope */
  .stage { position: relative; z-index: 1; text-align: center; }
  .envelope {
    position: relative;
    width: min(340px, 85vw);
    aspect-ratio: 3 / 2;
    margin: 0 auto;
    cursor: pointer;
    perspective: 800px;
    transition: transform .3s;
  }
  .envelope:hover { transform: translateY(-4px) rotate(-1deg); }
  .env-back { position: absolute; inset: 0; background: var(--env-dark); border-radius: 6px; box-shadow: 0 18px 40px rgba(0,0,0,.4); }
  .mini-letter { position: absolute; left: 8%; right: 8%; top: 8%; bottom: 10%; background: var(--paper); border-radius: 4px; z-index: 2; transition: transform .8s ease .5s; }
  .env-front { position: absolute; inset: 0; background: var(--env); clip-path: polygon(0 0, 50% 55%, 100% 0, 100% 100%, 0 100%); border-radius: 6px; z-index: 3; }
  .env-flap { position: absolute; inset: 0; background: var(--env-dark); clip-path: polygon(0 0, 100% 0, 50% 58%); transform-origin: top; transition: transform .6s ease; z-index: 4; }
  .seal { position: absolute; left: 50%; top: 52%; transform: translate(-50%, -50%); z-index: 5; font-size: 2.4rem; color: var(--accent); text-shadow: 0 2px 6px rgba(0,0,0,.25); transition: opacity .3s; }
  .envelope.open .env-flap { transform: rotateX(180deg); z-index: 1; }
  .envelope.open .seal { opacity: 0; }
  .envelope.open .mini-letter { transform: translateY(-65%); }
  .to-label { color: #f6d6de; font-family: 'Dancing Script', cursive; font-size: 2.2rem; margin-bottom: 22px; }
  .hint { color: #f6d6de; font-family: 'Dancing Script', cursive; font-size: 1.7rem; margin-top: 30px; animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .4; } }

  /* Letter */
  .letter {
    position: relative;
    z-index: 1;
    display: none;
    width: min(600px, 100%);
    max-height: 92vh;
    overflow-y: auto;
    background: var(--paper);
    border-radius: 8px;
    padding: 40px 36px;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
    opacity: 0;
    transform: translateY(30px) scale(.96);
    transition: opacity .8s ease, transform .8s ease;
  }
  .letter.show { opacity: 1; transform: none; }
  .eyebrow { font-family: 'Dancing Script', cursive; color: #b0607a; font-size: 1.4rem; margin-bottom: 4px; }
  .letter h1 { font-family: 'Dancing Script', cursive; font-size: 2.6rem; color: var(--accent); margin-bottom: 18px; }
  .letter .body { font-size: 1.25rem; line-height: 1.65; white-space: pre-wrap; min-height: 1em; }
  .cursor::after { content: '|'; color: var(--accent); animation: blink 1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .sign { font-family: 'Dancing Script', cursive; font-size: 1.9rem; text-align: right; margin-top: 26px; opacity: 0; transition: opacity 1.2s; }
  .sign span { display: block; font-size: 1.3rem; color: #8a5a66; }
  .skip { text-align: center; font-style: italic; font-size: .95rem; color: #a07c86; margin-top: 18px; }

  /* Photos */
  .extras { display: none; opacity: 0; transition: opacity 1s ease; margin-top: 30px; }
  .extras.show { opacity: 1; }
  .polaroids { display: flex; flex-wrap: wrap; gap: 22px; justify-content: center; align-items: center; margin: 10px 0 30px; }
  .polaroid {
    background: #fff;
    padding: 10px 10px 34px;
    box-shadow: 0 8px 22px rgba(0,0,0,.18);
    transform: rotate(-4deg);
    width: min(260px, 100%);
    position: relative;
  }
  .polaroid:nth-child(2) { transform: rotate(3deg); }
  .polaroid img { width: 100%; display: block; }
  .polaroid figcaption { position: absolute; bottom: 6px; left: 0; right: 0; text-align: center; font-family: 'Dancing Script', cursive; font-size: 1.3rem; color: var(--ink); }
  .ps { font-size: 1.15rem; font-style: italic; text-align: center; margin: 6px 0 26px; }
  .section-title { font-family: 'Dancing Script', cursive; font-size: 1.9rem; color: var(--accent); text-align: center; margin-bottom: 14px; }
  .collage { width: 100%; display: block; border-radius: 6px; margin-bottom: 18px; box-shadow: 0 6px 18px rgba(0,0,0,.15); }
  .dont {
    display: block; margin: 8px auto 4px;
    background: var(--blue); color: #fff; border: 0; border-radius: 999px;
    padding: 10px 20px; font: 600 1rem 'Cormorant Garamond', serif; cursor: pointer;
  }

  /* Jump scare */
  #scare {
    position: fixed; inset: 0; z-index: 100;
    display: none; flex-direction: column; align-items: center; justify-content: center; gap: 18px;
    background: var(--blue); cursor: pointer; overflow: hidden; text-align: center; padding: 16px;
  }
  #scare.on { display: flex; animation: flash .12s steps(1) 6; }
  @keyframes flash { 0% { background: #fff; } 50% { background: var(--blue); } }
  #scare img { width: min(78vmin, 560px); animation: zoom .3s cubic-bezier(.2, 1.7, .4, 1) forwards, shake .07s linear .3s 14; }
  @keyframes zoom { from { transform: scale(.05) rotate(-40deg); } to { transform: scale(1) rotate(0); } }
  @keyframes shake {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-14px, 10px) rotate(-4deg); }
    50% { transform: translate(12px, -12px) rotate(4deg); }
    75% { transform: translate(-10px, -6px) rotate(-2deg); }
    100% { transform: translate(0, 0); }
  }
  #scare .boo { font-family: 'Anton', Impact, sans-serif; color: #fff; font-size: clamp(2.6rem, 12vw, 6rem); letter-spacing: 2px; line-height: 1; text-shadow: 0 4px 0 #021f45; }
  #scare .back { color: #cfe0ff; font-size: 1.1rem; font-style: italic; }
  body.shaking { animation: shake .07s linear 10; }

  @media (max-width: 480px) {
    .letter { padding: 28px 20px; }
    .letter h1 { font-size: 2.2rem; }
    .letter .body { font-size: 1.12rem; }
  }
</style>
</head>
<body>

<div id="hearts"></div>

<div class="stage" id="stage">
  <p class="to-label">For Ahmed</p>
  <div class="envelope" id="envelope" role="button" aria-label="Open the letter" tabindex="0">
    <div class="env-back"></div>
    <div class="mini-letter"></div>
    <div class="env-front"></div>
    <div class="env-flap"></div>
    <div class="seal">♥</div>
  </div>
  <p class="hint" id="hint">Tap to open</p>
</div>

<article class="letter" id="letter">
  <p class="eyebrow">Happy 2 year anniversary</p>
  <h1 id="greeting"></h1>
  <p class="body cursor" id="body"></p>
  <p class="sign" id="sign"></p>
  <p class="skip" id="skip">tap the letter to skip ahead</p>

  <section class="extras" id="extras">
    <div class="polaroids">
      <figure class="polaroid"><img src="data:image/jpeg;base64," alt="Us at the match"><figcaption>us ♥</figcaption></figure>
      <figure class="polaroid"><img src="data:image/jpeg;base64," alt="Locket with our photos"><figcaption>favourite person</figcaption></figure>
    </div>
    <p class="ps">P.S. czasami śmierdzisz 😘</p>
    <p class="section-title">our little scrapbook</p>
    <img class="collage" src="data:image/jpeg;base64," alt="Collage one">
    <img class="collage" src="data:image/jpeg;base64," alt="Collage two">
    <button class="dont" id="dont">don't press this 💙</button>
  </section>
</article>

<div id="scare" role="dialog" aria-label="Surprise">
  <img src="data:image/png;base64," alt="Chelsea crest">
  <div class="boo">BOO! 💙</div>
  <div class="back">tap to go back to the soppy stuff</div>
</div>

<script>
  /* ============================================
     ✏️  EDIT THIS PART — names and message
     ============================================ */
  const CONFIG = {
    to: "Ahmed",
    from: "me",
    closing: "Love you more,",
    message: [
      "I know this is just the day we actually met, and our anniversary isn't till February, but again it's gonna be Ramadan, so I've just claimed now as our anniversary.",
      "I know I don't say this enough, but I appreciate you so much. I appreciate every little thing, every good morning, every call.",
      "I won't do my usual paragraph, you've probably gotten enough of them, but I love you so so much. Mwah mwah 😘"
    ],
    scareDelay: 4000   // ms after the letter finishes before the jump scare
  };
  /* ============================================ */

  const chars = Array.from(CONFIG.message.join("\n\n"));
  const $ = id => document.getElementById(id);
  const envelope = $('envelope'), stage = $('stage'), letter = $('letter');
  const bodyEl = $('body'), signEl = $('sign'), skipEl = $('skip'), extras = $('extras'), scare = $('scare');

  $('greeting').textContent = "Dear " + CONFIG.to + ",";
  signEl.innerHTML = "<span></span>";
  signEl.querySelector('span').textContent = CONFIG.closing;
  signEl.append(CONFIG.from + " ♥");

  // Floating hearts
  const heartsLayer = $('hearts');
  const colours = ['#d6336c', '#f06595', '#ff8fab', '#ffc2d1', '#e64980'];
  function spawnHeart() {
    const h = document.createElement('span');
    h.className = 'heart';
    h.textContent = '♥';
    h.style.left = Math.random() * 100 + 'vw';
    h.style.fontSize = (12 + Math.random() * 26) + 'px';
    h.style.color = colours[Math.floor(Math.random() * colours.length)];
    h.style.setProperty('--r', (Math.random() * 120 - 60) + 'deg');
    h.style.animationDuration = (6 + Math.random() * 6) + 's';
    heartsLayer.appendChild(h);
    h.addEventListener('animationend', () => h.remove());
  }
  setInterval(spawnHeart, 450);
  function burst(n) { for (let k = 0; k < n; k++) setTimeout(spawnHeart, k * 40); }

  // Sound (made in the browser, no file needed)
  let actx = null;
  function unlockAudio() {
    try { actx = actx || new (window.AudioContext || window.webkitAudioContext)(); actx.resume(); } catch (e) {}
  }
  function scream() {
    if (!actx) return;
    const t = actx.currentTime;
    const g = actx.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.45, t + 0.03);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 1.1);
    g.connect(actx.destination);
    [1, 1.5].forEach(mult => {
      const o = actx.createOscillator();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(200 * mult, t);
      o.frequency.exponentialRampToValueAtTime(1500 * mult, t + 0.25);
      o.frequency.exponentialRampToValueAtTime(500 * mult, t + 1.1);
      o.connect(g); o.start(t); o.stop(t + 1.1);
    });
    const buf = actx.createBuffer(1, actx.sampleRate * 0.5, actx.sampleRate);
    const d = buf.getChannelData(0);
    for (let k = 0; k < d.length; k++) d[k] = (Math.random() * 2 - 1) * (1 - k / d.length);
    const n = actx.createBufferSource(); n.buffer = buf; n.connect(g); n.start(t);
  }

  // Jump scare
  let scared = false;
  function jumpScare() {
    scare.classList.remove('on');
    void scare.offsetWidth;            // restart the animations
    scare.classList.add('on');
    document.body.classList.add('shaking');
    setTimeout(() => document.body.classList.remove('shaking'), 800);
    scream();
    if (navigator.vibrate) navigator.vibrate([200, 80, 300]);
  }
  scare.addEventListener('click', () => { scare.classList.remove('on'); burst(25); });
  $('dont').addEventListener('click', e => { e.stopPropagation(); jumpScare(); });

  // Typewriter
  let i = 0, done = false;
  function typeNext() {
    if (done) return;
    if (i < chars.length) {
      i++;
      bodyEl.textContent = chars.slice(0, i).join('');
      const c = chars[i - 1];
      const delay = c === '\n' ? 220 : (c === '.' || c === ',') ? 260 : 38;
      setTimeout(typeNext, delay);
    } else {
      finish();
    }
  }
  function finish() {
    if (done) return;
    done = true;
    bodyEl.textContent = chars.join('');
    bodyEl.classList.remove('cursor');
    signEl.style.opacity = 1;
    skipEl.style.display = 'none';
    extras.style.display = 'block';
    requestAnimationFrame(() => requestAnimationFrame(() => extras.classList.add('show')));
    burst(35);
    if (!scared) { scared = true; setTimeout(jumpScare, CONFIG.scareDelay); }
  }
  letter.addEventListener('click', finish);

  // Open the envelope
  function openEnvelope() {
    if (envelope.classList.contains('open')) return;
    unlockAudio();
    envelope.classList.add('open');
    $('hint').style.visibility = 'hidden';
    burst(20);
    setTimeout(() => {
      stage.style.display = 'none';
      letter.style.display = 'block';
      requestAnimationFrame(() => requestAnimationFrame(() => letter.classList.add('show')));
      setTimeout(typeNext, 800);
    }, 1500);
  }
  envelope.addEventListener('click', openEnvelope);
  envelope.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openEnvelope(); }
  });
</script>
</body>
</html>
